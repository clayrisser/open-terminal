{
  "name": "open-terminal",
  "version": "0.2.0",
  "description": "cross platform open terminal and run command",
  "sideEffects": false,
  "keywords": [
    "open-terminal",
    "open",
    "terminal",
    "cross",
    "platform"
  ],
  "homepage": "https://github.com/clayrisser/open-terminal",
  "bugs": {
    "url": "https://github.com/clayrisser/open-terminal/issues",
    "email": "email@clayrisser.com"
  },
  "license": "MIT",
  "author": {
    "name": "Clay Risser",
    "email": "email@clayrisser.com",
    "url": "https://clayrisser.com"
  },
  "files": [
    "bin",
    "es",
    "lib"
  ],
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "open-terminal": "bin/openTerminal.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clayrisser/open-terminal"
  },
  "scripts": {
    "build": "make -s build",
    "clean": "make -s clean",
    "format": "make -s format",
    "lint": "make -s lint",
    "prepare": "make -s prepare",
    "purge": "make -s purge",
    "test": "make -s test",
    "test:e2e": "make -s test/e2e",
    "test:unit": "make -s test/unit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=18"
  }
}
